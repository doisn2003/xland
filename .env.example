# Never put server secrets in NEXT_PUBLIC_* variables.
# Server-to-server Admin API; no PostgreSQL or Supabase service key in Next.js.
XLAND_ADMIN_API_URL=http://127.0.0.1:3005/api/v1/admin
# User website: the same /api/v1 as Flutter, never DATABASE_URL.
XLAND_API_BASE_URL=http://127.0.0.1:3005/api/v1
XLAND_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Enable only after the receiving team and booking/event policy are ready.
XLAND_ENABLE_BOOKING_WRITE=false
XLAND_ENABLE_EVENT_REGISTRATION=false
# Optional fixed public origin behind a reverse proxy, without trailing slash.
# XLAND_ADMIN_WEB_ORIGIN=https://your-website.example
