# Never put server secrets in NEXT_PUBLIC_* variables.
# Server-to-server Admin API; no PostgreSQL or Supabase service key in Next.js.
XLAND_ADMIN_API_URL=http://127.0.0.1:3005/api/v1/admin
# Optional fixed public origin behind a reverse proxy, without trailing slash.
# XLAND_ADMIN_WEB_ORIGIN=https://your-website.example
